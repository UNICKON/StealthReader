# 本机运行时文件：个人的阅读进度、窗口位置等，不进版本库
config.json

# 个人的划线 / 笔记 / 书签
annotations.json

# 事件日志
stealthreader.log

# 本机依赖：PyQt5 等 wheel 解包出来的目录（约 140MB）
libs/
wheels/
get_wheels.py

# Python 缓存
__pycache__/
*.pyc

# 社区页的本地缓存（列表 JSON + 落到本地的封面/正文图）。
# 删掉就是"下次重新拉"，里面全是别人的图，没有一条是本机独有数据。
cache/

# 社区页的登录凭据（我自己贴的 Cookie / UA）。
# **绝对不能进版本库**：这东西等同于账号密码。
# 连 `.bak` 一起忽略：保存时留的那份备份里也是明文 Cookie。
feed_auth.json
feed_auth.json.bak
